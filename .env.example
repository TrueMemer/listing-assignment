# Copy to .env.local if you need overrides. These values stay on the server.
# Default: invoke your installed, authenticated local Codex CLI.
# Codex uses your existing account. Local CLI does not mean on-device inference.
AI_PROVIDER=codex
# Leave blank to find codex on PATH or in supported desktop app locations.
CODEX_BIN=
# Leave blank to use the CLI's default model without loading user config.
CODEX_MODEL=
AI_TIMEOUT_MS=60000

# Optional alternative: set AI_PROVIDER=chat for an approved compatible endpoint.
# Example local Ollama endpoint:
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=qwen2.5:3b
# For a hosted provider, use HTTPS and set its key here.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Optional single HTTPS origin when hosting a controlled demo.
# The default permits loopback access only. No authentication is implemented.
PUBLIC_ORIGIN=

# Optional server-owned SQLite path. Default: .data/fieldnotes.sqlite
# Startup seeds a new database once. Existing records are retained.
FIELDNOTES_DB_PATH=

# Processed WebP uploads only; original filenames and metadata are discarded.
# Default: .data/uploads
FIELDNOTES_UPLOAD_DIR=

# Explicit user searches only. Read and accept the provider policy before enabling.
# https://operations.osmfoundation.org/policies/nominatim/
# No autocomplete, private data or bulk lookup. Aggregate limit: 1 request/second.
# The server caches results for 24 hours. Manual address/map links need no provider.
LOCATION_SEARCH_ENABLED=false
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
# Set a truthful application identifier and operator contact for your deployment.
NOMINATIM_USER_AGENT=Fieldnotes-Property-Assistant/1.0 (explicit location search; local assessment)
